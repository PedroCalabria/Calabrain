{
  "name": "@calabrain/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start:prod": "tsx ../../packages/db/src/migrate.ts && tsx src/server.ts"
  },
  "dependencies": {
    "@calabrain/db": "workspace:*",
    "@calabrain/shared": "workspace:*",
    "@calabrain/storage": "workspace:*",
    "@fastify/cors": "11.3.1",
    "better-auth": "1.7.13",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "nodemailer": "8.0.2",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.2.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "@aws-sdk/client-s3": "3.1156.0",
    "pdf-lib": "1.17.1"
  }
}
