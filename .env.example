# Copy to .env at the repo root. Values below match docker-compose.yml.

# --- Database
DATABASE_URL=postgres://calabrain:calabrain@localhost:5432/calabrain

# --- API
API_PORT=3000
# Public URL of the API (Better Auth uses it for callbacks).
API_URL=http://localhost:3000
# Public URL of the web app (CORS origin and links in e-mails).
WEB_URL=http://localhost:5173
# At least 32 random characters. Generate with: openssl rand -base64 32
AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars

# --- E-mail (password reset). Mailpit in development.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM="Calabrain <no-reply@calabrain.local>"

# --- Object storage. MinIO in development, Cloudflare R2 in production.
# R2: S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com and S3_REGION=auto
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=calabrain-dev
S3_ACCESS_KEY_ID=calabrain
S3_SECRET_ACCESS_KEY=calabrain-secret
S3_FORCE_PATH_STYLE=true

# --- Web (read by Vite, must start with VITE_)
VITE_API_URL=http://localhost:3000
